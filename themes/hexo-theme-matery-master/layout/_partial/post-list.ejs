<div class="post-list">
    <% posts.forEach(function (post) { %>
    <%
        var summary = post.summary || post.excerpt || post.content || '';
        summary = strip_html(summary).replace(/\s+/g, ' ').trim();
        if (summary.length > 150) {
            summary = summary.substring(0, 150) + '…';
        }
    %>
    <article class="post-row">
        <a class="post-row__hit" href="<%- url_for(post.path) %>">
            <div class="post-row__date">
                <time datetime="<%- date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time>
                <span><%= date(post.date, 'HH:mm') %></span>
            </div>

            <div class="post-row__body">
                <div class="post-row__meta">
                    <% post.categories.forEach(function (category, index) { %>
                        <% if (index === 0) { %><span><%= category.name %></span><% } %>
                    <% }); %>
                </div>
                <h2><%= post.title %></h2>
                <% if (summary) { %><p class="post-row__summary"><%= summary %></p><% } %>
                <% if (post.tags && post.tags.length > 0) { %>
                <div class="post-row__tags">
                    <% post.tags.forEach(function (tag, index) { %>
                        <% if (index < 3) { %><span class="post-tag">#<%= tag.name %></span><% } %>
                    <% }); %>
                </div>
                <% } %>
            </div>

            <span class="post-row__arrow" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
        </a>
    </article>
    <% }); %>
</div>
