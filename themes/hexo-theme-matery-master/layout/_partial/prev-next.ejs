<% if (page.prev || page.next) { %>
<nav id="prenext-posts" class="prev-next" aria-label="文章导航">
    <div class="prev-next__grid">
        <% if (page.prev) { %>
        <a class="prev-next__item prev-next__item--prev" href="<%- url_for(page.prev.path) %>">
            <span><i class="fas fa-arrow-left"></i> 上一篇</span>
            <strong><%= page.prev.title %></strong>
        </a>
        <% } %>

        <% if (page.next) { %>
        <a class="prev-next__item prev-next__item--next" href="<%- url_for(page.next.path) %>">
            <span>下一篇 <i class="fas fa-arrow-right"></i></span>
            <strong><%= page.next.title %></strong>
        </a>
        <% } %>
    </div>
</nav>
<% } %>
