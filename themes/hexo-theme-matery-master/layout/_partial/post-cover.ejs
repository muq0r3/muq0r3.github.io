<header class="post-hero">
    <div class="container">
        <div class="post-hero__meta">
            <span><%= date(page.date, 'YYYY.MM.DD') %></span>
            <% if (page.categories && page.categories.length > 0) { %>
                <% page.categories.forEach(function (category, index) { %>
                    <% if (index === 0) { %><span><%= category.name %></span><% } %>
                <% }); %>
            <% } %>
        </div>
        <h1><%= page.title %></h1>
        <% if (page.description) { %>
        <p class="post-hero__description"><%= page.description %></p>
        <% } %>
    </div>
</header>
