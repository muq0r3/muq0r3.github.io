<section class="editorial-hero">
    <div class="container editorial-hero__grid">
        <div class="editorial-hero__copy">
            <p class="hero-kicker">
                <span><%= config.title %></span>
                <span>技术笔记</span>
            </p>

            <h1>
                <span>具身智能</span>
                <span>学习笔记</span>
            </h1>

            <p class="hero-lede"><%= config.description %></p>

            <div class="hero-actions">
                <a class="hero-button" href="#articles">
                    看文章 <i class="fas fa-arrow-right"></i>
                </a>
                <a class="hero-text-link" href="<%- url_for('/about/') %>">
                    关于我 <i class="fas fa-arrow-up-right-from-square"></i>
                </a>
            </div>

            <% if (theme.homeTopics && theme.homeTopics.length > 0) { %>
            <div class="hero-topics">
                <% theme.homeTopics.forEach(function (topic) { %>
                <span><%= topic %></span>
                <% }); %>
            </div>
            <% } %>
        </div>

        <figure class="hero-visual">
            <div class="hero-visual__image"
                 style="background-image: url('<%- url_for('/medias/banner/0.jpg') %>')"></div>
            <figcaption>
                <span>MuQ / 2026</span>
                <span>具身智能 · 三维视觉 · 安全</span>
            </figcaption>
        </figure>
    </div>
</section>
