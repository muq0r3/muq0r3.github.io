<main class="page-main index-page">
    <%- partial('_partial/page-header', {
        title: '标签',
        kicker: 'TAGS',
        description: '按关键词浏览文章。'
    }) %>

    <section class="container term-index">
        <% if (site.tags.length > 0) { %>
        <div class="term-list">
            <% site.tags.forEach(function (tag) { %>
            <a href="<%- url_for(tag.path) %>">
                <span>#<%= tag.name %></span>
                <em><%= tag.length %></em>
            </a>
            <% }); %>
        </div>
        <% } else { %>
        <div class="post-empty">
            <span class="post-empty__index">00</span>
            <div><h3>还没有标签</h3><p>发布文章并添加标签后，这里会自动生成索引。</p></div>
        </div>
        <% } %>
    </section>
</main>
