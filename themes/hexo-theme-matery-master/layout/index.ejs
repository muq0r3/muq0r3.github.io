<%- partial('_partial/home-hero') %>

<main class="content home-content">
    <% if (page.current === 1 && theme.dream.enable) { %>
    <section class="home-intro">
        <div class="container home-intro__grid">
            <p class="section-label"><span>01</span> 关于这里</p>
            <div class="home-intro__copy">
                <h2><%= theme.dream.title %></h2>
                <p><%= theme.dream.text %></p>
            </div>
            <% if (theme.homeTopics && theme.homeTopics.length > 0) { %>
            <ul class="home-topic-list">
                <% theme.homeTopics.forEach(function (topic, index) { %>
                <li><span>0<%= index + 1 %></span><strong><%= topic %></strong></li>
                <% }); %>
            </ul>
            <% } %>
        </div>
    </section>
    <% } %>

    <section id="articles" class="container home-posts">
        <div class="section-heading">
            <div>
                <p class="section-label"><span>02</span> 最近写的</p>
                <h2>文章</h2>
            </div>
            <span class="section-count"><%= site.posts.length %> 篇</span>
        </div>

        <% if (page.posts.length > 0) { %>
            <%- partial('_partial/post-list', { posts: page.posts }) %>
        <% } else { %>
        <div class="post-empty">
            <span class="post-empty__index">00</span>
            <div>
                <h3>现在还没有文章</h3>
                <p>之前的文章已经删了，准备重新整理。可以先看关于页，或者去 GitHub 看看源码。</p>
            </div>
            <a class="hero-text-link" href="<%- url_for('/about/') %>">关于我 <i class="fas fa-arrow-right"></i></a>
        </div>
        <% } %>
    </section>
</main>

<% if (page.total > 1) { %>
<%- partial('_partial/paging') %>
<% } %>
