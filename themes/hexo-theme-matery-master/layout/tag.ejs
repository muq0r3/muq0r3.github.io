<main class="page-main index-page">
    <%- partial('_partial/page-header', {
        title: '# ' + page.tag,
        kicker: 'TAG',
        description: '带有这个标签的文章。'
    }) %>

    <section class="container archive-body">
        <% if (page.posts.length > 0) { %>
            <%- partial('_partial/post-list', { posts: page.posts }) %>
        <% } else { %>
        <div class="post-empty">
            <span class="post-empty__index">00</span>
            <div><h3>这个标签下还没有文章</h3><p>换个标签看看，或者回到首页。</p></div>
        </div>
        <% } %>
    </section>
</main>

<% if (page.total > 1) { %>
<%- partial('_partial/paging') %>
<% } %>
