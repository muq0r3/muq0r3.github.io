<main class="page-main about-page">
    <%- partial('_partial/page-header', {
        title: '关于我',
        kicker: 'ABOUT',
        description: '一个软件工程师的学习记录。'
    }) %>

    <div class="container about-shell">
        <aside class="profile-panel">
            <div class="profile-avatar">
                <img src="<%- theme.jsDelivr.url %><%- url_for(theme.profile.avatar) %>"
                     alt="<%- config.author %>">
            </div>
            <p class="profile-panel__kicker">MuQ</p>
            <h2><%= config.author %></h2>
            <p class="profile-panel__career"><%= theme.profile.career %></p>
            <div class="profile-panel__social">
                <%- partial('_partial/social-link') %>
            </div>
            <div class="profile-panel__stats">
                <%- partial('_partial/post-statis') %>
            </div>
        </aside>

        <article class="about-reading">
            <%- page.content %>
        </article>
    </div>
</main>
